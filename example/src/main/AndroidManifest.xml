<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IduraVerifyAndroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IduraVerifyAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Hosts the SDK on a plain android.app.Activity, for the instrumented tests to drive; see
            its KDoc. No LAUNCHER filter, so that startApp() still resolves unambiguously to
            MainActivity. Not exported either — the instrumentation shares the app's UID and starts
            it directly.
        -->
        <activity
            android:name=".PlainHostActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.IduraVerifyAndroid" />
    </application>

</manifest>