<?xml version="1.0" encoding="utf-8"?><!--
  The plain-Views counterpart of the Compose login screen, for PlainHostActivity. Only the two eIDs
  the instrumented tests drive are offered: the mock provider, which completes without leaving the
  browser, and MitID, whose real login page is something a cancellation test can close a tab on.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tab_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp" />

    <!--
      textAllCaps is off on both buttons because the tests match these labels exactly, and the
      platform Material theme would otherwise upper-case them.
    -->
    <Button
        android:id="@+id/login_with_mock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_with_mock"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/login_with_mitid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_with_mitid"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/identity_scheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="8dp" />
</LinearLayout>
